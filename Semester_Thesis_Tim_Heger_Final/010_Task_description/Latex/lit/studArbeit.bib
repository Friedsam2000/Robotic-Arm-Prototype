@Article{McDonough_1968,
  author    = {McDonough, R. and Huggins, W.H.},
  title     = {Best least-squares representation of signals by exponentials},
  journal   = {IEEE Transactions on Automatic Control},
  year      = {1968},
  volume    = {13},
  number    = {4},
  pages     = {408--412},
  doi       = {10.1109/TAC.1968.1098950},
  abstract  = {In this paper the approximation of a given real time function over(0, infty)by a linear combination of a given numbernof exponentials is considered, such that the integrated squared error is minimized over both thencoefficients of the linear combination and thenexponents used. The usual necessary condition for stationarity of the integrated squared error leads to a set of2nsimultaneous equations, nonlinear in the exponents. This condition is interpreted in the geometric language of abstract vector spaces, and an equivalent condition involving only the exponents, with the coefficients suppressed, is developed. It is next indicated how this latter condition can be applied to signals which are not known analytically, but only, for example, as voltages recorded on magnetic tape, or as a table of sampled values. The condition still in effect requires solution of nonlinear algebraic equations, and a linear iterative method is proposed for this purpose. Finally, the procedure is illustrated with a simple example.},
  comment   = {Thomas: Bereich signal processing, Meier-Luenberger Bedingungen, Erkennen der Pseudo-Optimalität, inkl. Orthogonalitätseigenschaften der Systeme; Approx eines Signals f(t)) benutzt pseudo-Optimalitaet; Aussage, dass für lokales Optimum G_e(s) auch noch orthogonal auf 1/(s-lambda_i)^2 stehen muss; daraus folgt eine Berechnung die nur mit den lambdas auskommt und diese optimal berechnet; sehr interessant; hat Analogien zu Prony's method; interessant waere das weiter zu untersuchen, ob das auch was im large-scale Fall bringen kann},
  file      = {:Best least-squares representation of signals by exponentials.pdf:PDF},
  owner     = {wolf},
  timestamp = {2014.03.27},
}

