  year      = {2006},
  month     = {12},
  pages     = {3405--3411},
  doi       = {10.1109/CDC.2006.376798},
  abstract  = {We investigate the use of inexact solves in a Krylov-based model reduction setting and present the resulting perturbation effects on the underlying model reduction problem. We show that for a good selection of interpolation points, Krylov-based model reduction is robust with respect to the perturbations due to inexact solves. On the other hand, when the interpolation points are poorly selected, these perturbations are magnified through the model reduction process. Finally, we incorporate inexact solves for the Krylov-based optimal H2 approximation. The result is an effective optimal model reduction algorithm applicable in realistic large-scale settings},
  file      = {:Inexact Solves in Krylov-based Model Reduction.pdf:PDF},
