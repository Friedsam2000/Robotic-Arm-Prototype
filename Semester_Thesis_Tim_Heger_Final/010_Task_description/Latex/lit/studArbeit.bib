@InProceedings{Ahmad_2010_Sylvester,
  author    = {Ahmad, Mian Ilyas and Jaimoukha, I. M. and Frangos, Michalis},
  title     = {Krylov Subspace Restart Scheme for Solving Large"=Scale Sylvester Equations},
  booktitle = {American Control Conference},
  year      = {2010},
  month     = {June},
  abstract  = {The development of efcient interior point methods has greatly enlarged the range of control problems with feasible numerical solution. These methods are nevertheless dif- cult to solve for large-scale problems. In this paper we suggest the use of a Krylov subspace technique for the efcient lowrank approximate solution to large-scale Sylvester equations. The suggested method is a novel restart scheme which improves further the computation efciency and storage requirements of the standard Krylov subspace methods for the solution of largescale Sylvester equations.},
  address   = {Baltimore, USA},
  comment   = {Thomas Iterative Lösung von Sylvester (Lyapunov)-Gleichung, wobei A_r auch large-scale sein darf. -> approximative Lösung und NICHT die exakte (für Lyapunov-Gl. wären Krylov-Räume die Cholesky-Faktoren). Das Residuum wird mit Hilfe von b_senkrecht formuliert. Dabei ist die Lösung der i+1-ten Iteration die i-te Lösung plus die Approx. der Gleichung mit b_{senkrecht,i}b_{senkrecht,i}^T statt bb^T als rechte Seite. Es wird zusätzlich die Astolfi'sche Parametrierung verwendet: A_r = S + b_r c_r_schlange (mit Umweg über orthogonale Proj.). Ausserdem wird W = W_schlange * M + W_senkrecht verwendet! Vorgehen: Berechne Krylov-V und mache orthogonale Projektion; führe Freiheitsgrad (=L) ein - als Abweichung vom orth.proj.Sys - zur Parametrierung aller red. Systeme die Momente matchen (=ganz analog zu Astolfi); Formuliere das Residuum der large-scale Lyap/Syl-Gleichung als N+n Rang Faktorisierung; bestimme L so, dass das Residuum Rang m hat (=> implizit: pseuod-opt); daraus folgt noch die Formulierung des Residuums als B_senkrecht*B_senkrecht' => Lypaunov-Gleichung mit B_senkrecht*B_senkrecht' als rechte Seite und (P-P_hat) als Lösung; damit kann erneut reduziert werden (=restart, Salamitaktik, CURE, etc.) und es folgt sofort monotone Konvergenz, da (P-P_hat) positiv ist und P_hat mit jeder Salamischeibe größer wird. Was NICHT erkannt wurde: Pseudo-Optimalität; sie haben S (=A_i), erkennen aber nicht dass die EW von S die Entwicklungspunkte sind; sie haben pseudo-optimales A_r (=A_m^L), erkennen aber nicht dass die EW davon die Spiegelstellen der Entwicklungspunkte sind; sie haben zwar die Salamitaktik in der Lyap-Gleichung, nicht aber für die MOR von G(s); sie haben nicht die Dualität mit S und C_r_tilde erkannt, sondern brauchen immer den Umweg über die orthogonale Projektion.},
  file      = {:Krylov Subspace Restart Scheme for Solving Large-Scale Sylvester.pdf:PDF},
  owner     = {wolf},
  timestamp = {2011.12.14},
}

